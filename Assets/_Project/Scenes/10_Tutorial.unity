  m_EditorClassIdentifier: Assembly-CSharp::HeroShooter.Systems.TutorialDirector
  motor: {fileID: 1180502780826249568}
  view: {fileID: 184209554}
  weapon: {fileID: 1180502780826249567}
  abilities: {fileID: 1180502780826249566}
  targets:
  - {fileID: 1680135491}
  - {fileID: 423917757}
  - {fileID: 1624232327}
  panel: {fileID: 142967138}
  steps:
  - gate: 0
    title: MOVEMENT
    body: Hold WASD to move. Cover 8 metres.
    threshold: 8
  - gate: 1
    title: LOOK
    body: 'Move the mouse: the camera orbits the hero. Turn it 60 degrees.'
    threshold: 60
  - gate: 2
    title: SHOOT
    body: Left click to fire. Bullets come from the pooled ProjectilePool - never Instantiate.
    threshold: 0
  - gate: 3
    title: ABILITY
    body: Press Q (first ability) or E (second). Both are ScriptableObject definitions.
    threshold: 0
  - gate: 4
    title: KILL
    body: Destroy a training dummy. Every enemy carries the same Health component.
    threshold: 0
  doneTitle: TRAINING COMPLETE
  doneBody: "Move \xB7 look \xB7 shoot \xB7 ability \xB7 kill \u2014 that is the whole game. Good luck on the maps."
  returnDelay: 4
